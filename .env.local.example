# 복사해서 .env.local로 쓴다. .env.local은 커밋되지 않는다.
# cp .env.local.example .env.local

# ── Supabase ────────────────────────────────────────────────────────────────
# Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# RLS를 우회한다. 서버에서만 쓴다. NEXT_PUBLIC_ 접두사를 붙이지 말 것.
SUPABASE_SERVICE_ROLE_KEY=

# ── Postgres 직결 (마이그레이션 전용) ────────────────────────────────────────
# SPEC §12.2 — 스키마 적용은 5432, 런타임 접근은 풀러(6543)를 쓴다.
SUPABASE_DB_URL_DIRECT=postgresql://postgres:PASSWORD@db.xxxxxxxxxxxx.supabase.co:5432/postgres

# ── NVIDIA NIM ──────────────────────────────────────────────────────────────
# 클라이언트에서 직접 부르지 않는다. /api/agent만 이 키를 본다.
NVIDIA_NIM_API_KEY=
NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_NIM_MODEL=

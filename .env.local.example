# 복사해서 .env.local로 쓴다. .env.local은 커밋되지 않는다.
# cp .env.local.example .env.local

# ── Supabase ────────────────────────────────────────────────────────────────
# Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# RLS를 우회한다. 서버에서만 쓴다. NEXT_PUBLIC_ 접두사를 붙이지 말 것.
# 배포하면 워커 secret 으로도 넣는다:  npx wrangler secret put SUPABASE_SERVICE_ROLE_KEY
SUPABASE_SERVICE_ROLE_KEY=

# ── Postgres 접속 (마이그레이션 전용) ────────────────────────────────────────
# SPEC §12.2 — 스키마 적용에만 쓴다. supabase-js는 PostgREST(HTTP)라 이 URL을 쓰지 않는다.
# Project Settings → Database → Connection string 에서 통째로 복사한다.
#
# ★ 세 가지를 조심한다. 여기서 제일 많이 막힌다.
#   1. 위의 NEXT_PUBLIC_SUPABASE_URL과 다른 값이다. https:// 로 시작하는 주소를
#      여기 넣으면 안 된다.
#   2. 복사하면 비밀번호 자리가 [YOUR-PASSWORD] 껍데기다. 프로젝트 만들 때 정한
#      DB 비밀번호로 바꾼다. @ : / ? # 가 있으면 URL 인코딩한다 (@ → %40).
#   3. "Direct connection"은 IPv6 전용이라 대부분의 국내 네트워크에서 안 붙는다.
#      그때는 같은 화면의 "Session pooler"를 쓴다 (포트는 그대로 5432).
#      Transaction pooler(6543)는 마이그레이션에 쓰지 않는다.
#
# Session pooler 모양 — 아이디에 점이 붙고 주소가 pooler.supabase.com이다:
#   postgresql://postgres.<ref>:<비번>@aws-1-ap-northeast-2.pooler.supabase.com:5432/postgres
SUPABASE_DB_URL_DIRECT=postgresql://postgres.xxxxxxxxxxxx:PASSWORD@aws-1-ap-northeast-2.pooler.supabase.com:5432/postgres

# ── LLM — NVIDIA NIM (SPEC §15-1-결정) ──────────────────────────────────────
# build.nvidia.com에서 키를 발급받는다 (nvapi- 로 시작).
# 클라이언트에서 직접 부르지 않는다. /api/agent만 이 키를 본다 (SPEC I4).
NVIDIA_NIM_API_KEY=
NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1
# 비우면 meta/llama-3.1-8b-instruct. 한국어 품질은 /lab에서 비교해 고른다.
NVIDIA_NIM_MODEL=

# ── 3D 월드 (멀티플레이 워커) ───────────────────────────────────────────────
# worker/ 의 Cloudflare Worker + Durable Object 와 짝이다. 자세한 건 worker/README.md.
#
# 브라우저가 접속할 워커 주소. 로컬은 `npm run world:dev`(wrangler dev)의 주소다.
#   로컬:  ws://127.0.0.1:8787
#   배포:  wss://<worker>.<계정>.workers.dev
#
# ★ 화면이 https로 열려 있으면(배포·터널) ws://는 브라우저가 mixed content로 막는다.
#   콘솔을 열지 않으면 "월드 서버에 붙지 못했다" 한 줄만 보인다. 반드시 wss://.
#
# ★ NEXT_PUBLIC_ 이라 **빌드 시점에 코드로 굳는다** — 서버 라우트에서도 그렇다.
#   `wrangler secret put NEXT_PUBLIC_WORLD_WS_URL` 은 아무 효과가 없다.
#   이 줄을 고쳤으면 `npm run app:deploy`로 다시 빌드해야 반영된다.
NEXT_PUBLIC_WORLD_WS_URL=ws://127.0.0.1:8787
#
# 워커가 좌석 명단을 물어볼 **Next 주소**. 위와 방향이 반대다 (워커 → Next).
#   로컬:  http://127.0.0.1:3000
#   배포:  https://humanish.<계정>.workers.dev   (Next 앱 워커. npm run app:deploy)
#          https://<무작위>.trycloudflare.com    (임시 터널. 재시작할 때마다 바뀐다)
#
# ★ 이 값은 **로컬 전용이다 — 어느 워커의 secret 으로도 넣지 않는다.** Next 런타임은
#   읽지 않는다. next.config.ts의 dev 전용 allowedDevOrigins와, `npm run world:deploy`가
#   월드 워커에 --var로 실어 보낼 때만 쓴다. 즉 "워커가 어디를 부를지"를 정하는 값이다.
#
# ★ 배포된 워커는 Cloudflare 엣지에서 돈다 — 거기서 127.0.0.1은 이 컴퓨터가 아니다.
#   로컬 주소인 채로 배포하면 좌석 명단이 오지 않아 화면엔 room_unavailable만 뜬다.
#   (/health는 200이고 소켓도 열려서 원인이 잘 안 보인다.)
#   world:deploy가 이 값을 검사하고 실어 보낸다. 넣을 환경변수 목록은 worker/README.md.
NEXT_ORIGIN=http://127.0.0.1:3000
#
# Next 와 워커가 나눠 갖는 비밀. 두 가지에 쓴다.
#   1. 입장 티켓 HMAC 서명 (/api/world/ticket 이 서명 → 워커가 검증)
#   2. 워커가 /api/internal/world-room 을 부를 때의 Bearer
# 아무 랜덤 문자열이면 된다:  openssl rand -hex 32
#
# 배포하면 **워커 둘 다** 같은 값을 들고 있어야 한다 (한 번만):
#   npx wrangler secret put WORLD_SHARED_SECRET                 # humanish (Next 앱)
#   cd worker && npx wrangler secret put WORLD_SHARED_SECRET    # humanish-world
WORLD_SHARED_SECRET=

{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(/**/dev.vars)",
      "Read(/**/.dev.vars)",
      "Read(/**/.env)",
      "Read(/**/.env.local)",
      "Read(/**/.env.*.local)",
      "Read(/**/.env.development)",
      "Read(/**/.env.production)",
      "Read(/**/.env.test)",
      "Read(/**/secrets.json)",
      "Read(/**/secrets.yaml)",
      "Read(/**/secrets.yml)",
      "Edit(/**/dev.vars)",
      "Edit(/**/.dev.vars)",
      "Edit(/**/.env)",
      "Edit(/**/.env.local)",
      "Edit(/**/.env.*.local)",
      "Edit(/**/.env.development)",
      "Edit(/**/.env.production)",
      "Edit(/**/.env.test)",
      "Edit(/**/secrets.json)",
      "Edit(/**/secrets.yaml)",
      "Edit(/**/secrets.yml)"
    ],
    "ask": [],
    "allow": []
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read|Edit|Write|NotebookEdit|Bash|Grep|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/deny-secrets.sh",
            "timeout": 5
          }
        ]
      }
    ]
  }
}

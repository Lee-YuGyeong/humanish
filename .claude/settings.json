{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(//Users/nowonsang/humanish/dev.vars)",
      "Read(//Users/nowonsang/humanish/.dev.vars)",
      "Read(//Users/nowonsang/humanish/**/dev.vars)",
      "Read(//Users/nowonsang/humanish/**/.dev.vars)",
      "Read(//Users/nowonsang/humanish/.env)",
      "Read(//Users/nowonsang/humanish/.env.*)",
      "Read(//Users/nowonsang/humanish/**/secrets.json)",
      "Read(//Users/nowonsang/humanish/**/secrets.yaml)",
      "Edit(//Users/nowonsang/humanish/dev.vars)",
      "Edit(//Users/nowonsang/humanish/.dev.vars)",
      "Edit(//Users/nowonsang/humanish/**/dev.vars)",
      "Edit(//Users/nowonsang/humanish/**/.dev.vars)",
      "Edit(//Users/nowonsang/humanish/.env)",
      "Edit(//Users/nowonsang/humanish/.env.*)",
      "Write(//Users/nowonsang/humanish/dev.vars)",
      "Write(//Users/nowonsang/humanish/.dev.vars)",
      "Write(//Users/nowonsang/humanish/**/dev.vars)",
      "Write(//Users/nowonsang/humanish/**/.dev.vars)",
      "Write(//Users/nowonsang/humanish/.env)",
      "Write(//Users/nowonsang/humanish/.env.*)",
      "Bash(cat:*dev.vars*)",
      "Bash(cat:*.env*)"
    ],
    "ask": [],
    "allow": []
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read|Edit|Write|NotebookEdit|Bash|Grep|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/deny-secrets.sh",
            "timeout": 5
          }
        ]
      }
    ]
  }
}

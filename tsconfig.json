{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,

    // strict 위에 얹는 검사들. 켜도 현재 에러 0이라 코드를 고칠 일이 없다.
    // 일부러 안 켠 것: noUncheckedIndexedAccess(178건) · noPropertyAccessFromIndexSignature(346건)
    // · exactOptionalPropertyTypes(13건) — 전부 lib/game/ 의 게임 규칙 코드를 손대게 된다.
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "allowUnreachableCode": false,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  // worker/ 는 Cloudflare 런타임이라 DOM이 아니라 @cloudflare/workers-types 를 쓴다.
  // 여기 섞으면 DurableObjectState 같은 타입이 없다고 빌드가 깨진다.
  // 검사는 worker/tsconfig.json 이 따로 한다 (cd worker && npm run typecheck).
  "exclude": ["node_modules", "worker"]
}

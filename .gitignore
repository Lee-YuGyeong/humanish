# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.local.example

# 로컬 비밀. Claude 접근 차단 대상 (.claude/settings.json + .claude/hooks/deny-secrets.mjs)
dev.vars
.dev.vars
secrets.json
secrets.yaml

# 월드 워커 (worker/). .dev.vars 는 위 "로컬 비밀"에서 이미 걸린다
/worker/node_modules
/worker/.wrangler

# vercel
.vercel

# 개인 로컬 설정
.claude/settings.local.json

# bkit 로컬 런타임 상태 (감사 로그 · 체크포인트). 공유하지 않는다
/.bkit/

# typescript
*.tsbuildinfo
next-env.d.ts

# OpenNext
.open-next

# wrangler files
.wrangler
.dev.vars*
!.dev.vars.example

# 3D 원본 모델 (각 75MB). 저장소에 넣지 않는다 — 웹에 쓰는 것은
# public/world/office-*.glb 이고, 만드는 순서는 app/world/avatar.tsx 머리말에 있다.
/3d_model/
# 3D 영상·음악 원본 (각 130MB / 22MB). 웹에 쓰는 것은 public/world/ 쪽이다 —
# 변환 명령은 app/world/music.ts · warehouse.tsx 머리말에 적어 둔다.
/3d_video/
/3d_music/
